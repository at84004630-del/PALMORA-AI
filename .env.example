# ==============================================================================
# Palmora AI - Complete Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` (backend & docker compose) and `apps/web/.env.local`
# Fill in real production credentials where appropriate. Never commit `.env` files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://palmora.ai","https://*.vercel.app"]

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Session Signing (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long with high cryptographic entropy.
# Generate in bash/PowerShell: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS_LONG

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database & Connection Pooling (Asyncpg + Row-Level Security)
# ------------------------------------------------------------------------------
# Set DATABASE_ENABLED=true to activate PostgreSQL persistence pool
DATABASE_ENABLED=false
# Application least-privilege connection (used by FastAPI)
DATABASE_URL=postgresql://palmora:palmora_dev@localhost:5432/palmora
# Dedicated administrative worker connection (for account deletion worker)
DATABASE_WORKER_URL=postgresql://palmora:palmora_dev@localhost:5432/palmora
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5.0
DATABASE_STATEMENT_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 4. Supabase Authentication & Realtime Storage
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Secret used by python-jose to cryptographically verify Supabase Auth JWTs
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 5. Payment Gateways (Razorpay for UPI & PayPal for Global Cards)
# ------------------------------------------------------------------------------
# Razorpay Configuration (UPI, Google Pay, PhonePe, Paytm, RuPay, NetBanking)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PayPal Configuration (USD, International Cards & PayPal Balance)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=live

# Approved Pricing (INR for Razorpay/UPI, USD for PayPal)
PRICE_PREMIUM_REPORT_INR=399
PRICE_DUAL_REPORT_INR=549
PRICE_MEMBERSHIP_INR_MONTHLY=699

PRICE_PREMIUM_REPORT_USD=4.99
PRICE_DUAL_REPORT_USD=6.99
PRICE_MEMBERSHIP_USD_MONTHLY=7.99

ENABLE_BILLING_SIMULATION=false

# ------------------------------------------------------------------------------
# 6. Computer Vision & Ephemeral Privacy
# ------------------------------------------------------------------------------
# Default is ephemeral memory (images discarded immediately post-analysis)
ENABLE_PERSISTENT_STORAGE=false
MAX_IMAGE_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 7. LLM Cultural Synthesis Engine (Gemini / OpenAI / Deterministic Fallback)
# ------------------------------------------------------------------------------
# Options: 'auto', 'gemini', 'openai', 'offline'
LLM_PROVIDER=auto
LLM_MODEL_NAME=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 8. Web Client (Next.js Public Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
